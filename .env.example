#--------------------------------------------------------------------
# KOMEO.ID Community Platform - Environment Configuration Example
# Copy this file to .env and configure the values for your environment.
# NEVER commit the actual .env file or real secrets to version control.
#--------------------------------------------------------------------

# Environment: production, development, or testing
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP SETTINGS
#--------------------------------------------------------------------
app.baseURL = 'https://komeo.id/'
app.indexPage = ''
app.forceGlobalSecureRequests = true
app.CSPEnabled = false
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = komeo_db
database.default.username = komeo_user
database.default.password = your_strong_database_password_here
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# SECURITY & CSRF PROTECTION
#--------------------------------------------------------------------
security.csrfProtection = 'session'
security.tokenRandomize = true
security.tokenName = 'csrf_token_komeo'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_komeo'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# ENCRYPTION KEY
# Generate using: php spark key:generate --force
#--------------------------------------------------------------------
encryption.key = 

#--------------------------------------------------------------------
# EMAIL & SMTP CONFIGURATION
#--------------------------------------------------------------------
email.fromEmail = 'noreply@komeo.id'
email.fromName = 'KOMEO.ID'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.mailgun.org'
email.SMTPUser = 'postmaster@komeo.id'
email.SMTPPass = 'your_smtp_password_here'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.SMTPTimeout = 10
email.mailType = 'html'
email.charset = 'utf-8'

#--------------------------------------------------------------------
# SESSION CONFIGURATION
#--------------------------------------------------------------------
